{
  "manifest_version": 3,
  "name": "SFMC UI Fixer — Multi BU",
  "version": "1.1.20",
  "description": "Strumenti per Marketing Cloud su Chrome e Microsoft Edge, configurabili per Business Unit.",
  "action": {
    "default_title": "SFMC UI Fixer — Impostazioni e versioni"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.exacttarget.com/*",
        "https://*.marketingcloud.com/*",
        "https://*.marketingcloudapps.com/*",
        "https://querystudio.herokuapp.com/*"
      ],
      "js": [
        "assets/js/email-studio-diagnostics-content.js",
        "assets/js/loader.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.exacttarget.com/cloud/*"
      ],
      "js": [
        "assets/js/email-studio-navigation-shell.js",
        "assets/js/test-tracking-shell.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.exacttarget.com/C12/Default.aspx*"
      ],
      "js": [
        "assets/js/email-studio-navigation-main.js",
        "assets/js/test-tracking-main.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/js/content.js",
        "assets/js/context.js",
        "assets/js/contactbuilder/*",
        "assets/js/contentbuilder/*",
        "assets/js/automation/*",
        "assets/js/querystudio/*",
        "assets/js/journey/*",
        "assets/js/components/*",
        "assets/css/*",
        "assets/html/contactbuilder/*",
        "assets/html/modals/*",
        "assets/html/previewandtest/*",
        "assets/html/querystudio/*"
      ],
      "matches": [
        "https://*.exacttarget.com/*",
        "https://*.marketingcloud.com/*",
        "https://*.marketingcloudapps.com/*",
        "https://querystudio.herokuapp.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "assets/js/background.js"
  },
  "host_permissions": [
    "https://*.exacttarget.com/*",
    "https://*.marketingcloud.com/*",
    "https://*.marketingcloudapps.com/*",
    "https://querystudio.herokuapp.com/*"
  ],
  "minimum_chrome_version": "111",
  "author": "Francesco Trepiccioni",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
