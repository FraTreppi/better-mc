{
  "manifest_version": 3,
  "name": "SFMC UI Fixer — Multi BU",
  "version": "1.1.4",
  "description": "Strumenti per Contact Builder, Content Builder, Automation Studio, Journey Builder e Query Studio, configurabili per Business Unit.",
  "action": {
    "default_title": "SFMC UI Fixer — Activity Versioning"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.exacttarget.com/*",
        "https://*.marketingcloud.com/*",
        "https://*.marketingcloudapps.com/*",
        "https://querystudio.herokuapp.com/*",
        "https://*.sfmc-content.com/*"
      ],
      "js": [
        "assets/js/email-studio-diagnostics-content.js",
        "assets/js/loader.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://*.exacttarget.com/cloud/*"],
      "js": ["assets/js/email-studio-navigation-shell.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.exacttarget.com/C12/Default.aspx*"],
      "js": ["assets/js/email-studio-navigation-main.js"],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/js/*",
        "assets/css/*",
        "assets/html/*"
      ],
      "matches": [
        "https://*.exacttarget.com/*",
        "https://*.marketingcloud.com/*",
        "https://*.marketingcloudapps.com/*",
        "https://querystudio.herokuapp.com/*",
        "https://*.sfmc-content.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "assets/js/background.js"
  },
  "host_permissions": [
    "https://*.exacttarget.com/*",
    "https://*.marketingcloud.com/*",
    "https://*.marketingcloudapps.com/*",
    "https://querystudio.herokuapp.com/*",
    "https://*.sfmc-content.com/*"
  ],
  "minimum_chrome_version": "111",
  "author": "Francesco Trepiccioni"
}
